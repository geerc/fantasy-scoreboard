#!/bin/bash
set -euo pipefail

CONTROL=/home/christiangeer/spotify_board/.venv/bin/spotify-board-control
CONTROL_FILE=/home/christiangeer/.spotify-board-mode
STATE_FILE=/run/fantasy-scoreboard.previous-mode
EXTERNAL_MODE_FILE=/run/fantasy-scoreboard.external-mode
SPOTIFY_DIR=/home/christiangeer/spotify_board

set_spotify_mode() {
    local mode="$1"
    runuser -u christiangeer -- sh -c \
        "cd '$SPOTIFY_DIR' && BOARD_CONTROL_FILE='$CONTROL_FILE' '$CONTROL' '$mode'"
}

case "${1:-}" in
    acquire)
        rm -f "$EXTERNAL_MODE_FILE"
        if [[ -e "$STATE_FILE" ]]; then
            echo "Fantasy Scoreboard already owns the saved board mode" >&2
            exit 1
        fi

        if [[ -f "$CONTROL_FILE" ]]; then
            previous_mode=$(tr -d '[:space:]' < "$CONTROL_FILE")
        else
            previous_mode=auto
        fi
        case "$previous_mode" in
            sports|spotify|off|auto) ;;
            *) previous_mode=auto ;;
        esac
        printf '%s\n' "$previous_mode" > "$STATE_FILE"

        set_spotify_mode off
        systemctl stop sportsmatrix.service
        ;;
    release)
        [[ -f "$STATE_FILE" ]] || exit 0
        if [[ -f "$EXTERNAL_MODE_FILE" ]]; then
            rm -f "$EXTERNAL_MODE_FILE" "$STATE_FILE"
            exit 0
        fi
        previous_mode=$(tr -d '[:space:]' < "$STATE_FILE")
        rm -f "$STATE_FILE"
        case "$previous_mode" in
            sports|spotify|off|auto) set_spotify_mode "$previous_mode" ;;
            *) set_spotify_mode auto ;;
        esac
        ;;
    *)
        echo "Usage: $0 acquire|release" >&2
        exit 2
        ;;
esac
