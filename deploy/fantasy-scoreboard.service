[Unit]
Description=Fantasy Football LED Scoreboard
After=network-online.target spotify-board-manager.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/christiangeer/fantasy-scoreboard
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/christiangeer/fantasy-scoreboard/scripts/run-physical-scoreboard
Restart=no
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
